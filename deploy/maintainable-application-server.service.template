# systemd unit template for running the Maintainable Application Server as a
# managed background service on a cloud instance, so it starts predictably,
# keeps running after the SSH/Session Manager session closes, and can be
# stopped cleanly with `systemctl stop`.
#
# This is a TEMPLATE: copy it to /etc/systemd/system/maintainable-application-server.service
# on the instance and replace every <PLACEHOLDER> before use. It contains no
# secrets and is safe to keep in version control.
#
# Usage on the instance (after editing placeholders):
#   sudo cp maintainable-application-server.service /etc/systemd/system/maintainable-application-server.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now maintainable-application-server
#   sudo systemctl status maintainable-application-server
#   journalctl -u maintainable-application-server -f          # follow logs
#   sudo systemctl stop maintainable-application-server       # stop cleanly

[Unit]
Description=Maintainable Application Server - lambda-based web framework
After=network.target

[Service]
Type=simple
User=<SERVICE_LINUX_USER>
WorkingDirectory=<APP_DIR>
Environment=PORT=<APP_PORT>
Environment=APP_ENV=production
Environment=GREETING_PREFIX=Hello
ExecStart=<JAVA_HOME>/bin/java -jar <APP_DIR>/maintainable-application-server-1.0.0.jar
Restart=on-failure
RestartSec=5
StandardOutput=append:/var/log/maintainable-application-server/app.log
StandardError=append:/var/log/maintainable-application-server/app.log

[Install]
WantedBy=multi-user.target
